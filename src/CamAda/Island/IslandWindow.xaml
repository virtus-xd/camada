<Window x:Class="CamAda.Island.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:t="clr-namespace:CamAda.Core.Text;assembly=CamAda.Core"
        xmlns:local="clr-namespace:CamAda.Island"
        xmlns:media="clr-namespace:CamAda.Media"
        xmlns:glass="clr-namespace:CamAda.Glass"
        Title="{x:Static t:UiStrings.Window_Island}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Width="1350" Height="160"
        FontFamily="{StaticResource Manrope}"
        Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True">
    <Window.Resources>
        <local:HalfHeightRadiusConverter x:Key="HalfHeight" />
    </Window.Resources>

    <Grid>
        <!-- Akıllı gizlenme: adanın yerini bir pencere kaplayınca görünen ince çizgi (tıklamaları engellemez) -->
        <Border x:Name="TuckLine" Width="96" Height="5" CornerRadius="2.5"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,3,0,0"
                Background="#CC14182A" BorderBrush="#66FFFFFF" BorderThickness="1"
                Opacity="0" IsHitTestVisible="False" />

        <!-- Hapın gölgesi: efektsiz katmanlar (DropShadowEffect, içindeki mini plak dönerken her karede yeniden hesaplanıyordu) -->
        <glass:SoftShadow x:Name="PillShadow" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0"
                          Width="{Binding ActualWidth, ElementName=PillBorder}"
                          Height="{Binding ActualHeight, ElementName=PillBorder}"
                          Opacity="{Binding Opacity, ElementName=PillBorder}" />

        <Border x:Name="PillBorder"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,8,0,0" Width="400" Height="40"
                Background="{StaticResource IslandTintBrush}"
                BorderBrush="{StaticResource GlassEdgeBrush}" BorderThickness="1"
                CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource HalfHeight}}">
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="HideTaskbarItem" Header="{x:Static t:UiStrings.Menu_HideTaskbar}" IsCheckable="True"
                              Click="HideTaskbarItem_Click" />
                    <MenuItem x:Name="StartWithWindowsItem" Header="{x:Static t:UiStrings.Menu_StartWithWindows}" IsCheckable="True"
                              Click="StartWithWindowsItem_Click" />
                    <MenuItem x:Name="HideRecordItem" Header="{x:Static t:UiStrings.Menu_HideRecord}" IsCheckable="True"
                              Click="HideRecordItem_Click" />
                    <MenuItem x:Name="AssistantItem" Header="{x:Static t:UiStrings.Menu_Assistant}" IsCheckable="True"
                              Click="AssistantItem_Click" />
                    <MenuItem Header="{x:Static t:UiStrings.Menu_AdaSettings}" Click="AssistantSettingsItem_Click" />
                    <MenuItem Header="{x:Static t:UiStrings.Menu_Glass}">
                        <MenuItem x:Name="GlassWallpaperItem" Header="{x:Static t:UiStrings.Menu_GlassWallpaper}" Click="GlassItem_Click" Tag="Wallpaper" />
                        <!-- Akrilik, WPF katmanlı penceresinde hap şekline kırpılamadığı için gizli (spec §9) -->
                        <MenuItem x:Name="GlassAcrylicItem" Header="{x:Static t:UiStrings.Menu_GlassAcrylic}" Click="GlassItem_Click" Tag="Acrylic" Visibility="Collapsed" />
                        <MenuItem x:Name="GlassSolidItem" Header="{x:Static t:UiStrings.Menu_GlassSolid}" Click="GlassItem_Click" Tag="Solid" />
                    </MenuItem>
                    <!-- Başlık ve seçenekler koddan (LanguageMenu); başlık her dilde "Dil / Language" -->
                    <MenuItem x:Name="LanguageItem" />
                    <MenuItem Header="{x:Static t:UiStrings.Menu_Exit}" Click="ExitItem_Click" />
                </ContextMenu>
            </Border.ContextMenu>

            <!-- ClipToBounds: genişlemiş satır sabit genişlikte durur, hap küçükken taşan kısmı kırpılır -->
            <Grid ClipToBounds="True">
                <!-- Duvar kağıdı camında bulanık görüntünün üstüne binen ton -->
                <Border x:Name="TintLayer" CornerRadius="{Binding CornerRadius, ElementName=PillBorder}" IsHitTestVisible="False" />

                <!-- Üst kenardaki ince parıltı -->
                <Border BorderBrush="{StaticResource GlassHighlightBrush}" BorderThickness="0,1,0,0"
                        CornerRadius="{Binding CornerRadius, ElementName=PillBorder}" IsHitTestVisible="False" />

                <!-- Küçük hâl (spec §7.1): boşta tarih (+ hava durumu) ya da çalarken mini plak + şarkı; sağda ekolayzır ve saat.
                     CompactLayer'ın saydamlığı kısa gösterge içindir, CompactContent'inki genişleme geçişi içindir. -->
                <Grid x:Name="CompactLayer">
                <Grid x:Name="CompactContent" Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="CompactDate" HorizontalAlignment="Left" VerticalAlignment="Center"
                               FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />

                    <!-- DockPanel: şarkı adı sağdaki işaretlerden kalan genişliğe sığmazsa "…" ile kısalır -->
                    <DockPanel x:Name="CompactMusic" VerticalAlignment="Center" Opacity="0" LastChildFill="True">
                        <media:MiniRecord x:Name="CompactRecord" DockPanel.Dock="Left" Diameter="24" VerticalAlignment="Center" />
                        <TextBlock x:Name="CompactTrack" Margin="8,0,12,0" VerticalAlignment="Center" MaxWidth="250"
                                   HorizontalAlignment="Left" TextTrimming="CharacterEllipsis">
                            <Run x:Name="CompactTitle" FontSize="12.5" FontWeight="Bold" /><Run x:Name="CompactArtist"
                                 FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                        </TextBlock>
                    </DockPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Ada oturumdayken mikrofonun açık olduğunu gösteren kırmızımsı nokta (Plan 5, gizlilik) -->
                        <Ellipse x:Name="CompactAdaDot" Width="8" Height="8" Fill="{StaticResource AdaDotBrush}" Margin="0,0,10,0"
                                 VerticalAlignment="Center" Visibility="Collapsed" AutomationProperties.Name="{x:Static t:UiStrings.Island_AdaListening}" />
                        <!-- Mikrofon kapalıyken kırmızımsı işaret (spec §7.1) -->
                        <TextBlock x:Name="CompactMicOff" Text="&#xEC54;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="13" Foreground="{StaticResource WarningBrush}" Margin="0,0,10,0"
                                   VerticalAlignment="Center" Visibility="Collapsed"
                                   AutomationProperties.Name="{x:Static t:UiStrings.Mic_Off}" />
                        <!-- Düşük pil (Plan 4.3): yalnız ≤ %20 ve şarjda değilken -->
                        <StackPanel x:Name="CompactBattery" Orientation="Horizontal" Margin="0,0,10,0"
                                    VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Text="&#xE851;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="CompactBatteryText" Margin="4,0,0,0" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center"
                                       Typography.NumeralAlignment="Tabular" />
                        </StackPanel>
                        <media:EqualizerBars x:Name="CompactEqualizer" Margin="0,0,10,0" VerticalAlignment="Center" Opacity="0" />
                        <!-- Zamanlayıcı (Plan 9): 60 dk'dan az kalan en yakın hatırlatmanın geri sayımı -->
                        <TextBlock x:Name="CompactTimer" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12.5" FontWeight="Bold"
                                   Typography.NumeralAlignment="Tabular" Visibility="Collapsed" />
                        <TextBlock x:Name="CompactTime" VerticalAlignment="Center"
                                   FontSize="13" FontWeight="ExtraBold" Typography.NumeralAlignment="Tabular" />
                    </StackPanel>
                </Grid>
                </Grid>

                <!-- Kısa gösterge (spec §7.5): ses değişti, mikrofon kapandı… Son çağrıdan 1,5 sn sonra kaybolur. -->
                <StackPanel x:Name="FlashRow" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Opacity="0" IsHitTestVisible="False">
                    <TextBlock x:Name="FlashGlyph" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                               VerticalAlignment="Center" />
                    <Grid x:Name="FlashTrack" Width="200" Height="4" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Border Background="#33FFFFFF" CornerRadius="2" />
                        <Border x:Name="FlashFill" Background="{StaticResource AccentBrush}" CornerRadius="2"
                                HorizontalAlignment="Left" Width="0" />
                    </Grid>
                    <!-- Uzun metin (hatırlatma, Plan 9) başı görünecek biçimde "…" ile kısalır -->
                    <TextBlock x:Name="FlashText" Margin="12,0,0,0" MinWidth="44" MaxWidth="320" VerticalAlignment="Center"
                               FontSize="12.5" FontWeight="Bold" Typography.NumeralAlignment="Tabular" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Ekran görüntüsü önizlemesi (Plan 4.2, spec §7.5): küçük resim + Kopyala / Düzenle; örtülüyken de
                     tıklanabilir, imleç üzerindeyken kaybolmaz. -->
                <Grid x:Name="ShotRow" Margin="12,0" Opacity="0" Visibility="Collapsed" VerticalAlignment="Center"
                      MouseEnter="ShotRow_MouseEnter" MouseLeave="ShotRow_MouseLeave">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="96" Height="54" CornerRadius="8">
                        <Border.Background>
                            <ImageBrush x:Name="ShotThumb" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                    <TextBlock Grid.Column="1" Text="{x:Static t:UiStrings.Island_Screenshot}" Margin="12,0,8,0" FontSize="12.5" FontWeight="Bold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button x:Name="ShotCopyButton" Grid.Column="2" Style="{StaticResource PanelButton}" Padding="10,5"
                            Margin="0,0,6,0" Click="ShotCopy_Click" AutomationProperties.Name="{x:Static t:UiStrings.Island_Copy}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="ShotCopyText" Text="{x:Static t:UiStrings.Island_Copy}" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="3" Style="{StaticResource PanelButton}" Padding="10,5" Click="ShotEdit_Click"
                            AutomationProperties.Name="{x:Static t:UiStrings.Island_Edit}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{x:Static t:UiStrings.Island_Edit}" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Ada'nın oturum satırı (Plan 5): nokta (dinlerken nabız atar), ✦ ya da ⚠ ve tek satır metin. Tıklayınca
                     oturum biter; ada bu sırada fareyle genişlemez. -->
                <Grid x:Name="AdaRow" Margin="18,0" Opacity="0" Visibility="Collapsed" VerticalAlignment="Center"
                      Background="Transparent" Cursor="Hand" ToolTip="{x:Static t:UiStrings.Island_StopAda}"
                      MouseLeftButtonUp="AdaRow_MouseLeftButtonUp">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- Misafir kipi (Plan 8): "iki kişi" simgesi, kip açıkken oturum boyunca -->
                    <TextBlock x:Name="AdaGuestGlyph" Text="&#xE716;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"
                               Visibility="Collapsed" />
                    <Ellipse x:Name="AdaDot" Grid.Column="1" Width="9" Height="9" Fill="{StaticResource AdaDotBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="AdaGlyph" Grid.Column="2" Margin="10,0,0,0" FontSize="14" VerticalAlignment="Center"
                               Visibility="Collapsed" />
                    <TextBlock x:Name="AdaLine" Grid.Column="3" Margin="12,0,0,0" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>

                <!-- Genişlemiş hâl: Başlat, Ara | uygulamalar | ^ | saat (spec §7.2) -->
                <!-- Genişliği koddan genişlemiş hapa sabitlenir (kenarlık hariç): hap büyürken düğmeler yeniden dizilmez,
                     satır her animasyon karesinde yeniden ölçülmez; küçük hâlde taşan kısım kırpılır. -->
                <local:IslandBar x:Name="ExpandedContent" HorizontalAlignment="Center" Opacity="0" IsHitTestVisible="False" />
            </Grid>
        </Border>
    </Grid>
</Window>
