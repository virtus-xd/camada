<UserControl x:Class="CamAda.Island.IslandBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:media="clr-namespace:CamAda.Media"
             Foreground="{StaticResource TextBrush}">
    <UserControl.Resources>
        <!-- Adadaki simge düğmeleri: odak almaz (ada odak çalmaz), üzerine gelince hafif aydınlanır -->
        <Style x:Key="IslandIconButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1FFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Separator" TargetType="Rectangle">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="Fill" Value="#2EFFFFFF" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="6,0" LastChildFill="False">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="StartButton" Style="{StaticResource IslandIconButton}" Width="34" Height="34"
                    AutomationProperties.Name="Başlat" Click="StartButton_Click">
                <Grid Width="20" Height="20">
                    <Ellipse Width="16" Height="16" Stroke="{StaticResource AccentBrush}" StrokeThickness="2.2" />
                    <Ellipse Width="5" Height="5" Fill="{StaticResource AccentBrush}" />
                </Grid>
            </Button>
            <Button x:Name="SearchButton" Style="{StaticResource IslandIconButton}" Width="34" Height="34"
                    AutomationProperties.Name="Ara" Click="SearchButton_Click">
                <Path Data="M11,5 A6,6 0 1 1 11,17 A6,6 0 1 1 11,5 Z M20,20 L15.5,15.5" Width="18" Height="18" Stretch="Uniform"
                      Stroke="{StaticResource TextBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Button>

            <Rectangle Style="{StaticResource Separator}" />

            <ItemsControl x:Name="Apps" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="{Binding Margin}" Height="44" Width="38">
                            <Button Style="{StaticResource IslandIconButton}" Width="36" Height="36"
                                    AutomationProperties.Name="{Binding AccessibleName}" Tag="{Binding}"
                                    Click="App_Click" PreviewMouseUp="App_PreviewMouseUp">
                                <Grid Width="26" Height="26">
                                    <Image x:Name="AppIcon" Source="{Binding Icon}" Opacity="{Binding IconOpacity}"
                                           RenderOptions.BitmapScalingMode="HighQuality">
                                        <Image.RenderTransform>
                                            <TranslateTransform />
                                        </Image.RenderTransform>
                                    </Image>
                                    <TextBlock Text="{Binding OverflowText}" FontSize="12.5" FontWeight="ExtraBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image Source="{Binding Badge}" Width="14" Height="14" Margin="0,-4,-4,0"
                                           HorizontalAlignment="Right" VerticalAlignment="Top"
                                           Visibility="{Binding BadgeVisibility}" />
                                </Grid>
                            </Button>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                        Margin="0,0,0,2" IsHitTestVisible="False">
                                <Border Width="4" Height="3" CornerRadius="1.5" Background="{Binding DotBrush}"
                                        Visibility="{Binding FirstDotVisibility}" />
                                <Border Width="4" Height="3" CornerRadius="1.5" Margin="2,0,0,0" Background="{Binding DotBrush}"
                                        Visibility="{Binding SecondDotVisibility}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <!-- Müzik bölümü (spec §7.2): mini plak + şarkı adı; tıklayınca Müzik paneli. Genişlik IslandLayout.MusicSectionWidth. -->
            <Button x:Name="MusicButton" Style="{StaticResource IslandIconButton}" Width="146" Height="36" Margin="0,0,4,0"
                    AutomationProperties.Name="Müzik: çalmıyor" Click="MusicButton_Click">
                <StackPanel Orientation="Horizontal" Width="134">
                    <Grid Width="26" Height="26">
                        <media:MiniRecord x:Name="MusicRecord" Diameter="26" />
                        <TextBlock x:Name="MusicGlyph" Text="&#xE8D6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="15" Foreground="{StaticResource TextSecondaryBrush}" Visibility="Collapsed"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock x:Name="MusicTitle" Margin="8,0,0,0" MaxWidth="100" VerticalAlignment="Center"
                               FontSize="12.5" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
            <Rectangle Style="{StaticResource Separator}" />
            <Button x:Name="TrayButton" Style="{StaticResource IslandIconButton}" Width="28" Height="34"
                    AutomationProperties.Name="Arka planda çalışan uygulamalar" Click="TrayButton_Click">
                <Path Data="M6,15 L12,9 L18,15" Width="14" Height="8" Stretch="Uniform"
                      Stroke="{StaticResource TextBrush}" StrokeThickness="2.2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            </Button>
            <TextBlock x:Name="TimeText" Margin="10,0,6,0" VerticalAlignment="Center"
                       FontSize="13" FontWeight="ExtraBold" Typography.NumeralAlignment="Tabular" />
        </StackPanel>
    </DockPanel>
</UserControl>
