<Window x:Class="CamAda.Record.RecordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CamAda.Record"
        xmlns:glass="clr-namespace:CamAda.Glass"
        Title="CamAda plak"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="False"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        FontFamily="{StaticResource Manrope}"
        Foreground="{StaticResource TextBrush}">
    <!-- Pencere ana ekranın sol kenarından başlar; diskin ekran dışı kısmı pencerede kırpılır (RecordLayout) -->
    <Canvas x:Name="Root" ClipToBounds="True" KeyboardNavigation.TabNavigation="Cycle">
        <!-- Kartın gölgesi (efektsiz) ve plaktan karta geçerken fare olayları kesilmesin diye neredeyse saydam köprü -->
        <glass:SoftShadow x:Name="CardShadow" Visibility="Hidden" />
        <Rectangle x:Name="CardBridge" Fill="#01000000" Visibility="Hidden" />
        <local:RecordDisc x:Name="Disc" Focusable="True" Cursor="Hand" FocusVisualStyle="{x:Null}"
                          AutomationProperties.Name="Plak" AutomationProperties.HelpText="Çal ya da duraklat">
            <!-- Gerçekçi plak: hâle, gölge, dönen disk + etiket, dönmeyen yansıma ve parlama -->
            <local:RecordVisual x:Name="Visual" />
            <!-- Klavye odağı halkası -->
            <Ellipse x:Name="FocusRing" Margin="-4" Stroke="{StaticResource AccentBrush}" StrokeThickness="2"
                     Visibility="Collapsed" IsHitTestVisible="False" />
        </local:RecordDisc>
    </Canvas>
</Window>
