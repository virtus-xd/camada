<UserControl x:Class="CamAda.Media.NowPlayingCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:t="clr-namespace:CamAda.Core.Text;assembly=CamAda.Core"
             Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource Manrope}">
    <UserControl.Resources>
        <!-- Önceki / sonraki ve kalp: yuvarlak, saydam, üzerine gelince aydınlanır -->
        <Style x:Key="RoundButton" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource PanelFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PanelItemHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PanelItemPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Oynat/duraklat: 40 DIP lamba turuncusu daire, koyu glif -->
        <Style x:Key="PlayButton" TargetType="Button" BasedOn="{StaticResource RoundButton}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource AccentBrush}" CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Çalan şarkı -->
        <StackPanel x:Name="PlayingView">
            <DockPanel LastChildFill="True">
                <!-- Kapak: yuvarlak köşeli arka plan olarak çizilir (köşeler kendiliğinden kırpılır) -->
                <Border x:Name="CoverFrame" DockPanel.Dock="Left" Width="72" Height="72" CornerRadius="12" Margin="0,0,14,0"
                        Background="#1A1A22" RenderOptions.BitmapScalingMode="HighQuality" />
                <Button x:Name="LikeButton" DockPanel.Dock="Right" Style="{StaticResource RoundButton}" VerticalAlignment="Top"
                        Margin="6,-4,-6,0" Visibility="Collapsed" Click="LikeButton_Click" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="SubtitleText" Margin="0,3,0,0" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>

            <!-- İlerleme ve süreler -->
            <Grid x:Name="ProgressArea" Margin="0,14,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border x:Name="ProgressTrack" Height="4" CornerRadius="2" Background="#24FFFFFF">
                    <Border x:Name="ProgressFill" HorizontalAlignment="Left" Width="0" CornerRadius="2"
                            Background="{StaticResource AccentBrush}" />
                </Border>
                <TextBlock x:Name="ElapsedText" Grid.Row="1" Margin="0,5,0,0" HorizontalAlignment="Left" FontSize="11.5"
                           Foreground="{StaticResource TextSecondaryBrush}" Typography.NumeralAlignment="Tabular" />
                <TextBlock x:Name="DurationText" Grid.Row="1" Margin="0,5,0,0" HorizontalAlignment="Right" FontSize="11.5"
                           Foreground="{StaticResource TextSecondaryBrush}" Typography.NumeralAlignment="Tabular" />
            </Grid>

            <!-- Denetimler -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                <Button x:Name="PreviousButton" Style="{StaticResource RoundButton}" Content="&#xE892;"
                        AutomationProperties.Name="{x:Static t:UiStrings.Card_Previous}" Click="PreviousButton_Click" />
                <Button x:Name="PlayPauseButton" Style="{StaticResource PlayButton}" Margin="14,0"
                        Click="PlayPauseButton_Click" />
                <Button x:Name="NextButton" Style="{StaticResource RoundButton}" Content="&#xE893;"
                        AutomationProperties.Name="{x:Static t:UiStrings.Card_Next}" Click="NextButton_Click" />
            </StackPanel>

            <!-- Sıradaki (Spotify Web API) -->
            <StackPanel x:Name="UpNextArea" Margin="0,12,0,0" Visibility="Collapsed">
                <TextBlock Text="{x:Static t:UiStrings.Card_UpNext}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,4" />
                <ItemsControl x:Name="UpNextList" Focusable="False">
                    <!-- Ekran okuyucu her satırı "Şarkı — Sanatçı" diye okusun (kayıt adını değil) -->
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="AutomationProperties.Name">
                                <Setter.Value>
                                    <MultiBinding StringFormat="{}{0} — {1}">
                                        <Binding Path="Title" />
                                        <Binding Path="Artist" />
                                    </MultiBinding>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontSize="12.5" Margin="0,2" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" — "
                                     Foreground="{StaticResource TextSecondaryBrush}" /><Run Text="{Binding Artist, Mode=OneWay}"
                                     Foreground="{StaticResource TextSecondaryBrush}" />
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>

        <!-- Hiçbir şey çalmıyor -->
        <StackPanel x:Name="EmptyView" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
            <TextBlock Text="{x:Static t:UiStrings.Card_NothingPlaying}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <Button Content="{x:Static t:UiStrings.Card_OpenSpotify}" Style="{StaticResource PanelButton}" Margin="0,12,0,0" HorizontalAlignment="Center"
                    AutomationProperties.Name="{x:Static t:UiStrings.Card_OpenSpotify}" Click="OpenSpotifyButton_Click" />
        </StackPanel>
    </Grid>
</UserControl>
