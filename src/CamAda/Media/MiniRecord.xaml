<UserControl x:Class="CamAda.Media.MiniRecord"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False" UseLayoutRounding="False">
    <!-- Küçük dönen plak: koyu disk, ince oluk izleri, ortada kapak etiketi ve mil deliği -->
    <Grid x:Name="Disc" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <RotateTransform x:Name="Spin" />
        </Grid.RenderTransform>
        <Ellipse Fill="#0D0D10" Stroke="#40FFFFFF" StrokeThickness="0.75" />
        <Ellipse x:Name="GrooveOuter" Stroke="#14FFFFFF" StrokeThickness="0.5" />
        <Ellipse x:Name="GrooveInner" Stroke="#10FFFFFF" StrokeThickness="0.5" />
        <Ellipse x:Name="Label" Fill="#1A1A22" Stroke="#59FFFFFF" StrokeThickness="0.5" />
        <Ellipse x:Name="Hole" Fill="#0D0D10" />
    </Grid>
</UserControl>
