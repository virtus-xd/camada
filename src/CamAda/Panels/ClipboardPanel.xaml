<UserControl x:Class="CamAda.Panels.ClipboardPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Satırın içindeki küçük simge düğmeleri (sabitle, sil): yalnız fareyle; klavyede Delete kullanılır -->
        <Style x:Key="RowIconButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="13">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PanelItemHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <Grid Margin="4,0,0,12">
            <TextBlock Text="Pano" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
            <Button x:Name="ClearButton" Style="{StaticResource PanelButton}" HorizontalAlignment="Right" Padding="10,4"
                    FontSize="12" Content="Sabitlenmeyenleri sil" Click="ClearButton_Click" />
        </Grid>

        <ScrollViewer x:Name="ListScroll" MaxHeight="420" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel>
                <StackPanel x:Name="PinnedList" />
                <Rectangle x:Name="PinnedSeparator" Height="1" Fill="#1FFFFFFF" Margin="4,4,4,8" Visibility="Collapsed" />
                <StackPanel x:Name="RecentList" />
                <TextBlock x:Name="EmptyText" Text="Kopyaladıkların burada görünür." Margin="4,0,0,4" FontSize="12.5"
                           Foreground="{StaticResource TextSecondaryBrush}" Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>

        <!-- Son ekran görüntüleri (tasarım "Ekran görüntüleri"): en yenisi solda, en çok 10 -->
        <Grid Margin="4,14,0,8">
            <TextBlock Text="Ekran görüntüleri" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}" />
            <Button x:Name="OpenFolderButton" Style="{StaticResource PanelButton}" HorizontalAlignment="Right" Padding="8,3"
                    FontSize="11.5" Click="OpenFolderButton_Click" AutomationProperties.Name="Klasörü aç">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE838;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                               VerticalAlignment="Center" />
                    <TextBlock Text="Klasörü aç" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
        <ScrollViewer x:Name="ShotsScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                      Focusable="False" PreviewMouseWheel="ShotsScroll_PreviewMouseWheel">
            <StackPanel x:Name="ShotsList" Orientation="Horizontal" />
        </ScrollViewer>
        <TextBlock x:Name="NoShotsText" Text="Henüz ekran görüntüsü yok" Margin="4,0,0,4" FontSize="12.5"
                   Foreground="{StaticResource TextSecondaryBrush}" Visibility="Collapsed" />
    </StackPanel>
</UserControl>
