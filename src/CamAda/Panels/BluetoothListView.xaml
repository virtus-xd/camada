<UserControl x:Class="CamAda.Panels.BluetoothListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:t="clr-namespace:CamAda.Core.Text;assembly=CamAda.Core">
    <StackPanel>
        <!-- Başlık: geri, "Bluetooth", telsiz anahtarı -->
        <DockPanel Margin="0,0,0,12">
            <Button x:Name="BackButton" DockPanel.Dock="Left" Style="{StaticResource PanelButton}" Padding="9,6"
                    AutomationProperties.Name="{x:Static t:UiStrings.Common_Back}" Click="BackButton_Click">
                <TextBlock Text="&#xE72B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" />
            </Button>
            <Button x:Name="RadioButton" DockPanel.Dock="Right" Style="{StaticResource PanelButton}" Padding="12,5"
                    Click="RadioButton_Click" />
            <TextBlock Text="Bluetooth" FontSize="15" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center" />
        </DockPanel>

        <TextBlock x:Name="StatusText" Margin="4,0,4,8" FontSize="12.5" TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondaryBrush}" Visibility="Collapsed" />

        <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel x:Name="Rows" />
        </ScrollViewer>

        <Button Style="{StaticResource PanelRowButton}" Margin="0,8,0,0" Click="AddButton_Click"
                AutomationProperties.Name="{x:Static t:UiStrings.Bt_AddDevice}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="11" VerticalAlignment="Center" />
                <TextBlock Text="{x:Static t:UiStrings.Bt_AddDevice}" FontSize="12.5" FontWeight="SemiBold" />
            </DockPanel>
        </Button>
    </StackPanel>
</UserControl>
