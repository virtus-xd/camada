<UserControl x:Class="CamAda.Panels.StartPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:t="clr-namespace:CamAda.Core.Text;assembly=CamAda.Core">
    <UserControl.Resources>
        <!-- Sonuç ve "Tüm uygulamalar" satırı: seçili ya da üzerine gelinen satır aydınlanır -->
        <Style x:Key="RowItem" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="12" Padding="10,6" Margin="0,0,0,2">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PanelItemBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PanelItemHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="RowTemplate">
            <DockPanel LastChildFill="True">
                <Grid Width="26" Height="26" Margin="0,0,12,0" DockPanel.Dock="Left">
                    <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <TextBlock DockPanel.Dock="Right" Text="{Binding KindText}" FontSize="11.5" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="12,0,0,0" />
                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </DataTemplate>

        <Style x:Key="RowList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource RowItem}" />
            <Setter Property="ItemTemplate" Value="{StaticResource RowTemplate}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="4,0,0,8" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        </Style>
    </UserControl.Resources>

    <!-- Tab: arama → sabitlenmişler → (Geri) → Tüm uygulamalar → güç düğmeleri → arama. Listeler arama kutusundan oklarla gezilir. -->
    <StackPanel KeyboardNavigation.TabNavigation="Cycle" PreviewTextInput="Panel_PreviewTextInput">
        <!-- Arama kutusu: panel açılınca odakta -->
        <Border CornerRadius="16" Background="{StaticResource PanelItemBrush}" Height="44" Padding="14,0"
                Margin="0,0,0,14">
            <Grid>
                <Path Data="M10,2 A8,8 0 1 1 9.99,2 M16,16 L22,22" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="2"
                      StrokeEndLineCap="Round" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Left"
                      VerticalAlignment="Center" />
                <TextBlock x:Name="Placeholder" Text="{x:Static t:UiStrings.Start_SearchPlaceholder}" Margin="30,0,0,0" FontSize="14"
                           VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBox x:Name="Query" Margin="28,0,0,0" FontSize="14" VerticalContentAlignment="Center"
                         Background="Transparent" BorderThickness="0" FocusVisualStyle="{x:Null}"
                         Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource TextBrush}"
                         SelectionBrush="{StaticResource AccentBrush}"
                         AutomationProperties.Name="{x:Static t:UiStrings.Bar_Search}"
                         TextChanged="Query_TextChanged" PreviewKeyDown="Query_PreviewKeyDown" />
            </Grid>
        </Border>

        <!-- İçerik: boşken sabitlenmişler ve son açılanlar; yazınca sonuçlar; ya da tüm uygulamalar -->
        <Grid Height="300">
            <StackPanel x:Name="HomeView">
                <TextBlock Text="{x:Static t:UiStrings.Start_Pinned}" Style="{StaticResource SectionTitle}" />
                <UniformGrid x:Name="PinnedGrid" Columns="6" />
                <TextBlock Text="{x:Static t:UiStrings.Start_Recent}" Style="{StaticResource SectionTitle}" Margin="4,14,0,8" />
                <ListBox x:Name="RecentList" Style="{StaticResource RowList}"
                         PreviewMouseLeftButtonUp="List_PreviewMouseLeftButtonUp" />
            </StackPanel>

            <ListBox x:Name="ResultsList" Style="{StaticResource RowList}" Visibility="Collapsed"
                     PreviewMouseLeftButtonUp="List_PreviewMouseLeftButtonUp" />

            <DockPanel x:Name="AllAppsView" Visibility="Collapsed">
                <Button DockPanel.Dock="Top" Style="{StaticResource PanelButton}" Content="{x:Static t:UiStrings.Start_Back}"
                        HorizontalAlignment="Left" Margin="0,0,0,8" Click="BackButton_Click" />
                <ListBox x:Name="AllAppsList" Style="{StaticResource RowList}"
                         PreviewMouseLeftButtonUp="List_PreviewMouseLeftButtonUp" />
            </DockPanel>
        </Grid>

        <!-- Alt satır: Tüm uygulamalar | Kilitle, Uyku, Yeniden başlat, Kapat -->
        <DockPanel Margin="0,14,0,0" LastChildFill="False">
            <Button x:Name="AllAppsButton" Style="{StaticResource PanelButton}" Content="{x:Static t:UiStrings.Start_AllApps}"
                    Click="AllAppsButton_Click" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="LockButton" Style="{StaticResource PanelButton}" Content="{x:Static t:UiStrings.Start_Lock}"
                        Click="LockButton_Click" />
                <Button x:Name="SleepButton" Style="{StaticResource PanelButton}" Content="{x:Static t:UiStrings.Start_Sleep}" Margin="6,0,0,0" Click="SleepButton_Click" />
                <Button x:Name="RestartButton" Style="{StaticResource PanelButton}" Content="{x:Static t:UiStrings.Start_Restart}"
                        Margin="6,0,0,0" Click="RestartButton_Click" />
                <Button x:Name="ShutdownButton" Style="{StaticResource PanelButton}" Content="{x:Static t:UiStrings.Start_Shutdown}" Margin="6,0,0,0"
                        Click="ShutdownButton_Click" />
            </StackPanel>
        </DockPanel>
    </StackPanel>
</UserControl>
