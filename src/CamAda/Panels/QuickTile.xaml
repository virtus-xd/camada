<UserControl x:Class="CamAda.Panels.QuickTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="64">
    <UserControl.Resources>
        <!-- Kutucuğun tıklanan bölümü: zemini kutucuk verir, bölüm yalnız üzerine gelince/basınca aydınlanır -->
        <Style x:Key="TilePart" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource PanelFocusVisual}" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="12">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#24FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border x:Name="Bd" CornerRadius="12" Background="{StaticResource PanelItemBrush}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="MainPart" Style="{StaticResource TilePart}" Click="MainPart_Click" PreviewKeyDown="MainPart_PreviewKeyDown">
                <StackPanel Orientation="Horizontal" Margin="14,0,6,0">
                    <TextBlock x:Name="GlyphText" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                               VerticalAlignment="Center" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" FontSize="12.5" FontWeight="Bold" />
                        <TextBlock x:Name="SubtitleText" FontSize="11.5" FontWeight="SemiBold" Opacity="0.8" MaxWidth="96"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>
            </Button>
            <Button x:Name="DetailsPart" Grid.Column="1" Width="34" Style="{StaticResource TilePart}"
                    Click="DetailsPart_Click" Visibility="Collapsed">
                <TextBlock Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                           HorizontalAlignment="Center" />
            </Button>
        </Grid>
    </Border>
</UserControl>
