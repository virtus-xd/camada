<UserControl x:Class="CamAda.Panels.SoundPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="4,0,0,6" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="Ses ve mikrofon" FontSize="15" FontWeight="Bold" Margin="4,0,0,12" />

        <!-- Ana ses: sessize al düğmesi, kaydırıcı, yüzde -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="48" />
            </Grid.ColumnDefinitions>
            <Button x:Name="MuteButton" Style="{StaticResource PanelButton}" Padding="8,6" Click="MuteButton_Click"
                    AutomationProperties.Name="Sesi kapat">
                <TextBlock x:Name="MuteGlyph" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" />
            </Button>
            <Slider x:Name="VolumeSlider" Grid.Column="1" Style="{StaticResource PanelSlider}" Margin="12,0,8,0"
                    VerticalAlignment="Center" AutomationProperties.Name="Ses düzeyi"
                    ValueChanged="VolumeSlider_ValueChanged" />
            <TextBlock x:Name="PercentText" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center"
                       FontSize="12.5" FontWeight="Bold" Typography.NumeralAlignment="Tabular" />
        </Grid>

        <TextBlock Text="Çıkış" Style="{StaticResource SectionTitle}" />
        <StackPanel x:Name="OutputList" />
        <TextBlock x:Name="NoOutputText" Text="Ses çıkış cihazı bulunamadı." Margin="4,0,0,4" FontSize="12.5"
                   Foreground="{StaticResource TextSecondaryBrush}" Visibility="Collapsed" />
    </StackPanel>
</UserControl>
