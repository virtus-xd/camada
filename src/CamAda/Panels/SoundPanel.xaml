<UserControl x:Class="CamAda.Panels.SoundPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:t="clr-namespace:CamAda.Core.Text;assembly=CamAda.Core">
    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="4,0,0,6" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="{x:Static t:UiStrings.Bar_Sound}" FontSize="15" FontWeight="Bold" Margin="4,0,0,12" />

        <!-- Ana ses: sessize al düğmesi, kaydırıcı, yüzde -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="48" />
            </Grid.ColumnDefinitions>
            <Button x:Name="MuteButton" Style="{StaticResource PanelButton}" Padding="8,6" Click="MuteButton_Click"
                    AutomationProperties.Name="{x:Static t:UiStrings.Sound_Mute}">
                <TextBlock x:Name="MuteGlyph" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" />
            </Button>
            <Slider x:Name="VolumeSlider" Grid.Column="1" Style="{StaticResource PanelSlider}" Margin="12,0,8,0"
                    VerticalAlignment="Center" AutomationProperties.Name="{x:Static t:UiStrings.Sound_Volume}"
                    ValueChanged="VolumeSlider_ValueChanged" />
            <TextBlock x:Name="PercentText" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center"
                       FontSize="12.5" FontWeight="Bold" Typography.NumeralAlignment="Tabular" />
        </Grid>

        <TextBlock Text="{x:Static t:UiStrings.Sound_Output}" Style="{StaticResource SectionTitle}" />
        <StackPanel x:Name="OutputList" />
        <TextBlock x:Name="NoOutputText" Text="{x:Static t:UiStrings.Sound_NoOutput}" Margin="4,0,0,4" FontSize="12.5"
                   Foreground="{StaticResource TextSecondaryBrush}" Visibility="Collapsed" />

        <!-- O an ses çıkaran uygulamalar (panel açıkken saniyede bir tazelenir) -->
        <TextBlock Text="{x:Static t:UiStrings.Sound_Apps}" Style="{StaticResource SectionTitle}" Margin="4,12,0,6" />
        <StackPanel x:Name="AppList" />
        <TextBlock x:Name="NoAppsText" Text="{x:Static t:UiStrings.Sound_NoApps}" Margin="4,0,0,4" FontSize="12.5"
                   Foreground="{StaticResource TextSecondaryBrush}" />

        <!-- Varsayılan kayıt cihazı -->
        <TextBlock Text="{x:Static t:UiStrings.Sound_Mic}" Style="{StaticResource SectionTitle}" Margin="4,12,0,6" />
        <Grid x:Name="MicRow" Margin="4,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="MicGlyph" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="MicNameText" Grid.Column="1" Margin="10,0,8,0" FontSize="12.5" FontWeight="SemiBold"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button x:Name="MicButton" Grid.Column="2" Click="MicButton_Click" />
        </Grid>
        <TextBlock x:Name="NoMicText" Text="{x:Static t:UiStrings.Sound_NoMic}" Margin="4,0,0,4" FontSize="12.5"
                   Foreground="{StaticResource TextSecondaryBrush}" Visibility="Collapsed" />
    </StackPanel>
</UserControl>
