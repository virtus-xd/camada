<UserControl x:Class="CamAda.Panels.AdaPanel" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="4,14,0,6" />
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="Ada — sesli asistan" FontSize="15" FontWeight="Bold" Margin="4,0,0,10" />

        <!-- Anahtar yokken: açıklama, AI Studio, gizli kutu, Kaydet (Live kurulumuyla doğrulanır) -->
        <StackPanel x:Name="KeySection">
            <TextBlock Style="{StaticResource Note}"
                       Text="Ada, &quot;Hey Ada&quot; deyince ya da Win+Alt+A ile uyanır; Google Gemini ile konuşur. Kendi Gemini API anahtarın gerekir (ücretli katman önerilir; anahtar bu bilgisayarda Windows şifrelemesiyle saklanır)." />
            <Button Style="{StaticResource PanelButton}" Content="Google AI Studio'da anahtar al" HorizontalAlignment="Left"
                    Margin="4,10,0,10" Click="OpenStudio_Click" />
            <DockPanel LastChildFill="True">
                <Button x:Name="SaveKeyButton" DockPanel.Dock="Right" Style="{StaticResource PanelAccentButton}" Content="Kaydet"
                        Margin="10,0,0,0" Click="SaveKey_Click" />
                <Border CornerRadius="10" Background="{StaticResource PanelItemBrush}" Padding="10,0">
                    <PasswordBox x:Name="KeyBox" Height="30" VerticalContentAlignment="Center" FontSize="12.5"
                                 Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"
                                 CaretBrush="{StaticResource TextBrush}" SelectionBrush="{StaticResource AccentBrush}"
                                 AutomationProperties.Name="Gemini API anahtarı" KeyDown="KeyBox_KeyDown" />
                </Border>
            </DockPanel>
            <TextBlock x:Name="KeyStatus" Style="{StaticResource Note}" Margin="4,8,0,0" Visibility="Collapsed" />
        </StackPanel>

        <!-- Anahtar varken: aç/kapat, mikrofon, aylık tahmin, anahtarı sil, hafıza -->
        <StackPanel x:Name="SettingsSection" Visibility="Collapsed">
            <Button x:Name="EnabledButton" Style="{StaticResource PanelRowButton}" Click="Enabled_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Sesli asistan açık" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="EnabledState" Grid.Column="1" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center" />
                </Grid>
            </Button>
            <TextBlock x:Name="SavedNote" Style="{StaticResource Note}" Margin="4,6,0,0" Visibility="Collapsed"
                       Foreground="{StaticResource TextSecondaryBrush}" />

            <TextBlock Text="Mikrofon" Style="{StaticResource SectionTitle}" />
            <StackPanel x:Name="MicList" />

            <TextBlock x:Name="UsageText" Style="{StaticResource Note}" Margin="4,12,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}" />
            <Button x:Name="ForgetKeyButton" Style="{StaticResource PanelButton}" Content="Anahtarı sil" HorizontalAlignment="Left"
                    Margin="4,10,0,0" Click="ForgetKey_Click" />

            <TextBlock Text="Hafıza" Style="{StaticResource SectionTitle}" />
            <TextBlock Style="{StaticResource Note}" Foreground="{StaticResource TextSecondaryBrush}" Margin="4,0,0,6"
                       Text="Ada'nın senin hakkında aklında tuttukları. Her konuşmada Google'a talimatla birlikte gider." />
            <StackPanel x:Name="MemoryList" />
            <TextBlock x:Name="NoMemoryText" Style="{StaticResource Note}" Text="Henüz bir şey kaydetmedi."
                       Foreground="{StaticResource TextSecondaryBrush}" Visibility="Collapsed" />
            <Button x:Name="ClearMemoryButton" Style="{StaticResource PanelButton}" Content="Hafızayı temizle"
                    HorizontalAlignment="Left" Margin="4,10,0,0" Click="ClearMemory_Click" />
        </StackPanel>
    </StackPanel>
</UserControl>
