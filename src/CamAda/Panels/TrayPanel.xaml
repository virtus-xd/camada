<UserControl x:Class="CamAda.Panels.TrayPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:t="clr-namespace:CamAda.Core.Text;assembly=CamAda.Core"
             xmlns:local="clr-namespace:CamAda.Panels">
    <UserControl.Resources>
        <local:FirstLineConverter x:Key="FirstLine" />
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="{x:Static t:UiStrings.Tray_Title}" FontSize="15" FontWeight="Bold" Margin="4,0,0,12" />

        <ItemsControl x:Name="Icons" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="4" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- Fare olayları tepsi uygulamasına iletilir (RetroBar'daki gibi); düğme değil, çünkü sağ tık da gerekir -->
                    <Border x:Name="Cell" Background="Transparent" CornerRadius="14" Padding="4,8" Margin="2"
                            Cursor="Hand" ToolTip="{Binding Title}"
                            MouseEnter="Icon_MouseEnter" MouseLeave="Icon_MouseLeave" MouseMove="Icon_MouseMove"
                            MouseDown="Icon_MouseDown" MouseUp="Icon_MouseUp">
                        <StackPanel>
                            <Image Source="{Binding Icon}" Width="30" Height="30"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="{Binding Title, Converter={StaticResource FirstLine}}" FontSize="11.5"
                                       Margin="0,6,0,0" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                    <DataTemplate.Triggers>
                        <Trigger SourceName="Cell" Property="IsMouseOver" Value="True">
                            <Setter TargetName="Cell" Property="Background" Value="{StaticResource PanelItemHoverBrush}" />
                        </Trigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock x:Name="EmptyText" Text="{x:Static t:UiStrings.Tray_Empty}" Margin="4,4,0,0" FontSize="12.5"
                   Foreground="{StaticResource TextSecondaryBrush}" Visibility="Collapsed" />

        <TextBlock Text="{x:Static t:UiStrings.Tray_Hint}"
                   Margin="4,12,4,0" FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />
    </StackPanel>
</UserControl>
